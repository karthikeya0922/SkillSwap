# Used by docker-compose.yml. Copy to .env and fill in real values (never commit .env).
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# At least 32 random characters: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret

# Demo data (set SEED_ENABLED=false in production)
SEED_ENABLED=true
SEED_DEMO_PASSWORD=Demo@12345
ADMIN_EMAIL=admin@skillswap.dev
ADMIN_PASSWORD=Admin@12345
