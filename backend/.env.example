# Copy to backend/.env (git-ignored) for local development.
DB_URL=jdbc:mysql://localhost:3306/skillswap?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=change-me
# At least 32 characters. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
# Demo data: seeded students sign in with <firstname>@skillswap.dev and this password
SEED_ENABLED=true
SEED_DEMO_PASSWORD=Demo@12345
ADMIN_EMAIL=admin@skillswap.dev
ADMIN_PASSWORD=Admin@12345
