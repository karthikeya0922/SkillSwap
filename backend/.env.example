# Local Development Configuration for SkillSwap Backend
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/skillswap?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=root

# Security: JWT secret must be at least 32 characters
JWT_SECRET=skillswap-local-development-jwt-secret-key-must-be-32-chars-minimum
JWT_EXPIRATION_MINUTES=1440

# Demo data seeds
SEED_ENABLED=true
SEED_DEMO_PASSWORD=demo1234
ADMIN_EMAIL=admin@skillswap.dev
ADMIN_PASSWORD=admin1234
